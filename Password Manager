# --- Anti-Debugging Check ---
if ctypes.windll.kernel32.IsDebuggerPresent():
    sys.exit(1)

APP_DIR = os.path.dirname(os.path.abspath(__file__))
VAULT_FILE = os.path.join(APP_DIR, "pyvault_native.bin")
AUTH_FILE = os.path.join(APP_DIR, "pyvault_native_auth.bin")
SALT_SIZE = 32

# --- Windows C-API Native Functions ---
user32 = ctypes.windll.user32
kernel32 = ctypes.windll.kernel32

# Register Windows Clipboard exclusion formats
CF_CLIPBOARD_VIEWER_IGNORE = user32.RegisterClipboardFormatW("Clipboard Viewer Ignore")
CF_CAN_INCLUDE_IN_CLIPBOARD_HISTORY = user32.RegisterClipboardFormatW("CanIncludeInClipboardHistory")
CF_CAN_UPLOAD_TO_CLOUD_CLIPBOARD = user32.RegisterClipboardFormatW("CanUploadToCloudClipboard")

def zero_memory(data: bytearray):
    """Overwrites memory buffer with zeroes directly in RAM."""
    if data:
        location = (ctypes.c_char * len(data)).from_buffer(data)
        ctypes.memset(location, 0, len(data))

def lock_ram_pages(data: bytearray):
    """Prevents RAM buffer from being paged to disk (pagefile.sys)."""
    if data:
        location = (ctypes.c_char * len(data)).from_buffer(data)
        kernel32.VirtualLock(location, len(data))

def copy_to_clipboard_secure(text: str):
    """
    Copies text to clipboard using Windows C-API while explicitly blocking
    Windows Clipboard History (Win + V) and Cloud Clipboard Sync.
    """
    if not user32.OpenClipboard(None):
        return

    user32.EmptyClipboard()

    # 1. Copy Plaintext Unicode Data
    text_bytes = text.encode('utf-16le') + b'\x00\x00'
    h_mem = kernel32.GlobalAlloc(0x0002, len(text_bytes)) # GMEM_MOVEABLE
    ptr = kernel32.GlobalLock(h_mem)
    ctypes.memmove(ptr, text_bytes, len(text_bytes))
    kernel32.GlobalUnlock(h_mem)
    user32.SetClipboardData(13, h_mem) # CF_UNICODETEXT = 13

    # 2. Set Win + V Clipboard History Exclude Flag (DWORD = 0)
    h_flag_history = kernel32.GlobalAlloc(0x0002, 4)
    ptr_flag = kernel32.GlobalLock(h_flag_history)
    ctypes.memset(ptr_flag, 0, 4)
    kernel32.GlobalUnlock(h_flag_history)
    user32.SetClipboardData(CF_CAN_INCLUDE_IN_CLIPBOARD_HISTORY, h_flag_history)

    # 3. Set Cloud Clipboard Sync Exclude Flag (DWORD = 0)
    h_flag_cloud = kernel32.GlobalAlloc(0x0002, 4)
    ptr_flag_c = kernel32.GlobalLock(h_flag_cloud)
    ctypes.memset(ptr_flag_c, 0, 4)
    kernel32.GlobalUnlock(h_flag_cloud)
    user32.SetClipboardData(CF_CAN_UPLOAD_TO_CLOUD_CLIPBOARD, h_flag_cloud)

    user32.CloseClipboard()

def clear_clipboard_native():
    """Immediately empties Windows clipboard via Win32 C-API."""
    if user32.OpenClipboard(None):
        user32.EmptyClipboard()
        user32.CloseClipboard()

def derive_key(master_password: str, salt: bytes) -> bytearray:
    """Derives a key using Argon2id and returns a lockable bytearray."""
    raw = hash_secret_raw(
        secret=master_password.encode(),
        salt=salt,
        time_cost=3,
        memory_cost=65536,
        parallelism=4,
        hash_len=32,
        type=Type.ID
    )
    b_array = bytearray(raw)
    lock_ram_pages(b_array)
    return b_array

class HardenedVault(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("PyVault Native (Win32 Protected)")
        self.geometry("550x380")
        self.resizable(False, False)
        
        self.master_key = None
        self.protocol("WM_DELETE_WINDOW", self.on_close)
        
        if not os.path.exists(AUTH_FILE) or not os.path.exists(VAULT_FILE):
            self.show_setup()
        else:
            self.show_login()

    def on_close(self):
        self.wipe_session()
        self.destroy()

    def wipe_session(self):
        clear_clipboard_native()
        if self.master_key:
            zero_memory(self.master_key)
            self.master_key = None

    def show_setup(self):
        for w in self.winfo_children(): w.destroy()
        f = ttk.Frame(self, padding=20); f.pack(expand=True)
        ttk.Label(f, text="Initialize Vault", font=("Segoe UI", 14, "bold")).pack(pady=10)
        e1 = ttk.Entry(f, show="*", width=30); e1.pack(pady=5)
        e2 = ttk.Entry(f, show="*", width=30); e2.pack(pady=5)

        def save():
            p1, p2 = e1.get(), e2.get()
            if len(p1) < 12 or p1 != p2:
                messagebox.showerror("Error", "Password must be 12+ chars and match.")
                return
            
            salt = os.urandom(SALT_SIZE)
            key = derive_key(p1, salt)
            aesgcm = AESGCM(bytes(key))
            nonce = os.urandom(12)
            token = aesgcm.encrypt(nonce, b"verify_native", None)

            with open(AUTH_FILE, "wb") as file:
                file.write(salt + nonce + token)

            self.master_key = key
            self.save_data({})
            self.show_dashboard()

        ttk.Button(f, text="Create Vault", command=save).pack(pady=10)

    def show_login(self):
        for w in self.winfo_children(): w.destroy()
        f = ttk.Frame(self, padding=20); f.pack(expand=True)
        ttk.Label(f, text="PyVault Native Unlock", font=("Segoe UI", 14, "bold")).pack(pady=10)
        e = ttk.Entry(f, show="*", width=30); e.pack(pady=10); e.focus()

        def login(event=None):
            with open(AUTH_FILE, "rb") as file: data = file.read()
            salt, nonce, token = data[:SALT_SIZE], data[SALT_SIZE:SALT_SIZE+12], data[SALT_SIZE+12:]
            
            key = derive_key(e.get(), salt)
            try:
                aesgcm = AESGCM(bytes(key))
                if aesgcm.decrypt(nonce, token, None) == b"verify_native":
                    self.master_key = key
                    self.show_dashboard()
                    return
            except Exception:
                pass
            
            zero_memory(key)
            messagebox.showerror("Error", "Invalid Master Password")

        self.bind('<Return>', login)
        ttk.Button(f, text="Unlock", command=login).pack(pady=5)

    def load_data() -> dict:
        with open(VAULT_FILE, "rb") as f: content = f.read()
        nonce, ciphertext = content[:12], content[12:]
        aesgcm = AESGCM(bytes(self.master_key))
        return json.loads(aesgcm.decrypt(nonce, ciphertext, None).decode())

    def save_data(self, data: dict):
        raw = json.dumps(data).encode()
        nonce = os.urandom(12)
        aesgcm = AESGCM(bytes(self.master_key))
        with open(VAULT_FILE, "wb") as f:
            f.write(nonce + aesgcm.encrypt(nonce, raw, None))

    def show_dashboard(self):
        for w in self.winfo_children(): w.destroy()
        self.unbind('<Return>')
        f = ttk.Frame(self, padding=15); f.pack(fill=tk.BOTH, expand=True)

        self.listbox = tk.Listbox(f, width=25)
        self.listbox.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        right_f = ttk.Frame(f, padding=10); right_f.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True)
        self.lbl_user = ttk.Label(right_f, text="Select entry..."); self.lbl_user.pack(pady=10)

        def on_select(evt):
            sel = self.listbox.curselection()
            if sel:
                entry = self.load_data().get(self.listbox.get(sel[0]), {})
                self.lbl_user.config(text=f"User: {entry.get('username')}")
                self.active_pass = entry.get('password')

        self.listbox.bind('<<ListboxSelect>>', on_select)

        def copy_pass():
            if hasattr(self, 'active_pass'):
                copy_to_clipboard_secure(self.active_pass)
                messagebox.showinfo("Copied", "Copied! Excluded from Win+V history. Clears in 8s.")
                self.after(8000, clear_clipboard_native)

        ttk.Button(right_f, text="📋 Secure Copy", command=copy_pass).pack(pady=5)
        ttk.Button(right_f, text="+ Add Entry", command=self.add_entry).pack(pady=5)
        self.refresh_list()

    def refresh_list(self):
        self.listbox.delete(0, tk.END)
        for s in sorted(self.load_vault_data().keys()):
            self.listbox.insert(tk.END, s)

    def add_entry(self):
        d = tk.Toplevel(self); d.geometry("300x200")
        s_e = ttk.Entry(d); s_e.pack(pady=2)
        u_e = ttk.Entry(d); u_e.pack(pady=2)
        p_e = ttk.Entry(d, show="*"); p_e.pack(pady=2)

        def save():
            data = self.load_data()
            data[s_e.get().strip().lower()] = {"username": u_e.get().strip(), "password": p_e.get().strip()}
            self.save_data(data)
            self.refresh_list()
            d.destroy()

        ttk.Button(d, text="Save", command=save).pack(pady=10)

if __name__ == "__main__":
    app = HardenedVault()
    app.mainloop()
